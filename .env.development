ENV=development

## 前端开发服务器端口
VITE_CLI_PORT=8002

## 后端服务端口（与 VITE_BASE_PATH 组成 vite 代理目标）
VITE_SERVER_PORT=1011

## 接口前缀，对应 Swagger 的 /api
VITE_BASE_API=/api

## 后端主机 - 开发联调 WebApi：192.168.2.110:1011
## 个人覆盖用 .env.development.local
VITE_BASE_PATH=http://192.168.2.110

## 开发服务是否暴露到局域网。默认仅 localhost
VITE_DEV_HOST=true
