# 复制为 .env.development 或 .env.development.local 后按环境修改

VITE_CLI_PORT=8001
VITE_SERVER_PORT=9012
VITE_BASE_API=/api
VITE_BASE_PATH=http://127.0.0.1

# 如需局域网访问开发服务，设为 true
VITE_DEV_HOST=true

# 生产环境应由后端 Set-Cookie（HttpOnly）管理会话
# VITE_AUTH_STORAGE=sessionStorage

# 后端数据解密密钥与初始向量（Base64，AES-256-CBC / PKCS#7），由后端提供后填入
# 未配置时收到加密数据会提示"数据解密密钥未配置"，明文数据不受影响
VITE_CRYPTO_KEY=
VITE_CRYPTO_IV=
