# 复制为 .env.development 或 .env.development.local 后按环境修改
#
# 约定：
# - 开发联调：VITE_BASE_PATH=http://192.168.2.110 + VITE_SERVER_PORT=1011（WebApi）
# - 正式/同域托管：见 .env.production（接口用相对路径）

VITE_CLI_PORT=8002
VITE_SERVER_PORT=1011
VITE_BASE_API=/api
VITE_BASE_PATH=http://192.168.2.110

# 如需局域网访问开发服务，设为 true
VITE_DEV_HOST=true
