# 生产 / 正式联调（npm run build）
# 约定：正式环境后端 192.168.2.131；开发见 .env.development（110）
#
# 同域托管在 WebApi wwwroot（131:1020）时，接口走相对路径（VITE_BASE_API），
# 门户路由会跳过 /api 前缀直打 /auth、/news 等；VITE_BASE_PATH 作备用说明，不拼进 axios。

VITE_BASE_API=/api
VITE_BASE_PATH=http://192.168.2.131

## 后端数据解密密钥与初始向量（AES-256-CBC / PKCS#7），此处存掩码串而非明文，
## 由明文 Base64 生成：node scripts/mask-crypto-secret.mjs <明文Key> <明文Iv>
VITE_CRYPTO_KEY=ZC3iqw3GSoldFfeEG/18hm9k+qcYxXy+ZjDZiiXCQcNDG/yaJNBaqX4H4v8=
VITE_CRYPTO_IV=UwfesTz9YNh/a+K0Of18nm1o2K8m5TXO
